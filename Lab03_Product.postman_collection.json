    {
      "name": "19 - Token sai chu ky",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{badToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "const parts=pm.collectionVariables.get(\"token\").split(\".\");",
              "parts[2]=(parts[2][0]===\"A\"?\"B\":\"A\")+parts[2].slice(1);",
              "pm.variables.set(\"badToken\",parts.join(\".\"));",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
              "pm.test(\"Token rejected\",()=>pm.expect(pm.response.json().error).to.eql(\"INVALID_TOKEN\"));",
              "})();"
            ]
          }
        }
      ],
      "response": []
    },
