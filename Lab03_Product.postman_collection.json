{
  "info": {
    "name": "Lab03_Product - Flask + XAMPP MySQL + BTH2 JWT",
    "description": "Chạy BTH2 :5001 và BTH3 :5002; MySQL XAMPP :3306. Chạy theo thứ tự. POST/PUT đủ name, description, price, quantity. price trả chuỗi giữ chính xác 2 số lẻ. Collection chỉ xóa sản phẩm do nó tạo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Thieu JWT GET - 401",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));",
              "pm.test(\"JWT required\",()=>pm.expect(pm.response.json().error).to.eql(\"MISSING_TOKEN\"));",
              "})();"
            ]
          }
        }
      ],
      "response": []
    },
