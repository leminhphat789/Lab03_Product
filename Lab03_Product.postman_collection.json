              "const result=pm.response.json();",
              "pm.test(\"Updated name\",()=>pm.expect(result.name).to.eql(\"Bàn phím cơ đã cập nhật\"));",
              "pm.test(\"Updated price\",()=>pm.expect(result.price).to.eql(\"1199000.00\"));",
              "pm.test(\"Updated stock\",()=>pm.expect(result.quantity).to.eql(7));",
              "pm.test(\"Creation preserved\",()=>pm.expect(result.created_at).to.eql(pm.collectionVariables.get(\"createdAt\")));",
              "})();"
            ]
