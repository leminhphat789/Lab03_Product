    {
      "name": "08 - Tao san pham",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/products",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bàn phím cơ thực hành\",\n  \"description\": \"Sản phẩm kiểm thử BTH3\",\n  \"price\": \"1250000.50\",\n  \"quantity\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const result=pm.response.json();",
              "pm.test(\"ID created\",()=>pm.expect(result.id).to.be.above(0));",
              "pm.test(\"Exact DECIMAL\",()=>pm.expect(result.price).to.eql(\"1250000.50\"));",
              "pm.test(\"Location\",()=>pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/products/\"+result.id));",
              "pm.test(\"Timestamps\",()=>{pm.expect(result.created_at).to.be.a(\"string\");pm.expect(result.updated_at).to.be.a(\"string\");});",
              "pm.collectionVariables.set(\"productId\",result.id);",
              "pm.collectionVariables.set(\"createdAt\",result.created_at);",
              "})();"
            ]
          }
        }
      ],
      "response": []
    },
