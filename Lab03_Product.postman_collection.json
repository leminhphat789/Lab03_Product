    {
      "name": "06 - Dang nhap BTH2 - Base64",
      "request": {
        "method": "POST",
        "url": "{{authUrl}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{passwordBase64}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.variables.set(\"passwordBase64\", require(\"btoa\")(pm.collectionVariables.get(\"password\")));",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const result=pm.response.json();",
              "pm.test(\"JWT received\",()=>pm.expect(result.access_token).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"token\",result.access_token);",
              "})();"
            ]
          }
        }
      ],
      "response": []
    },
